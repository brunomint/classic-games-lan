<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="24dp" /><solid android:color="@color/sombra" /></shape>
    </item>
    <item>
        <layer-list>
            <item><shape><corners android:radius="24dp" /><solid android:color="@color/sombra" /></shape></item>
            <item android:bottom="3dp"><shape><corners android:radius="24dp" /><solid android:color="@color/branco" /></shape></item>
        </layer-list>
    </item>
</selector>
