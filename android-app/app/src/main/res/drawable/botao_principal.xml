<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><corners android:radius="32dp" /><solid android:color="@color/sombra" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="32dp" /><solid android:color="@color/laranja_escuro" /></shape>
    </item>
    <item>
        <layer-list>
            <item><shape><corners android:radius="32dp" /><solid android:color="@color/laranja_escuro" /></shape></item>
            <item android:bottom="5dp"><shape><corners android:radius="32dp" /><solid android:color="@color/laranja" /></shape></item>
        </layer-list>
    </item>
</selector>
