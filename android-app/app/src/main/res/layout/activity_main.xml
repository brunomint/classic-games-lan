<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/grafite"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/desligado"
            android:textColor="@color/cinza"
            android:textSize="16sp" />

        <Button
            android:id="@+id/botao"
            android:layout_width="220dp"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/botao_principal"
            android:stateListAnimator="@null"
            android:text="@string/ligar"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/endereco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/grafite"
            android:textIsSelectable="true"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/cinza"
            android:textSize="14sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/qr"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/cartao"
            android:contentDescription="QR code do endereço"
            android:padding="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/abrir_aqui"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/botao_claro"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:stateListAnimator="@null"
            android:text="@string/abrir_aqui"
            android:textAllCaps="false"
            android:textColor="@color/grafite"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/cartao"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pasta_titulo"
                android:textColor="@color/grafite"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pasta_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/cinza"
                android:textSize="14sp" />

            <Button
                android:id="@+id/pasta_botao"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/botao_claro_cinza"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:stateListAnimator="@null"
                android:text="@string/pasta_botao"
                android:textAllCaps="false"
                android:textColor="@color/grafite"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/busca_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/cinza"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/busca_botao"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/botao_claro_cinza"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:stateListAnimator="@null"
                android:text="@string/busca_ligar"
                android:textAllCaps="false"
                android:textColor="@color/grafite"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/busca_desligar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:text="@string/busca_desligar"
                android:textAllCaps="false"
                android:textColor="@color/cinza"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/rodape"
            android:textColor="@color/cinza"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
